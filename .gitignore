# SLAI app-platform deployment: never commit plaintext secrets or TLS keys.
*.raw.yaml
deploy/slai-app-prod/**/csr/tls.key
# Track the encrypted handoff bundle (copied to slai-app-platform by Deploy prod).
*.enc.yaml
!deploy/slai-app-prod/**/secrets.enc.yaml
!deploy/slai-app-prod/**/tls-secret.enc.yaml

